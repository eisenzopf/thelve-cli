#!/bin/sh
set -eu
umask 027

receipt=/var/lib/thelve-bootstrap/gcp-v2.complete
if [ -f "$receipt" ]; then
  exit 0
fi

for command in docker containerd chronyd nft jq curl sha256sum awk stat; do
  command -v "$command" >/dev/null
done
docker compose version >/dev/null
test -x /usr/local/libexec/thelve-image-qualification
/usr/local/libexec/thelve-image-qualification >/dev/null

%{ if !enable_ops_agent ~}
# The qualified GCP host must disable guest-agent Cloud Logging before its first
# boot. Changing this setting from a metadata startup script restarts the guest
# agent while OS Login/IAP is coming online and permits an initial denied export.
# Fail closed if an unqualified image reaches this deployment target.
# Required image state: cloud_logging_enabled = false
guest_agent_config=/etc/default/instance_configs.cfg
test -f "$guest_agent_config"
test ! -L "$guest_agent_config"
test "$(stat -c '%U:%G:%a' "$guest_agent_config")" = root:root:644
test "$(awk -F= '
  BEGIN { in_core = 0; matches = 0 }
  /^\[Core\][[:space:]]*$/ {
    in_core = 1
    next
  }
  /^\[/ {
    in_core = 0
  }
  in_core && $1 ~ /^[[:space:]]*cloud_logging_enabled[[:space:]]*$/ {
    value = $2
    gsub(/[[:space:]]/, "", value)
    if (value == "false") matches++
  }
  END {
    if (matches == 1) print "false"
  }
' "$guest_agent_config")" = false
%{ endif ~}

# The privileged host materializer needs workload identity, but application
# containers do not. GCP exposes its guest DNS resolver and metadata service on
# the same link-local address, so admit only DNS before blocking bridge traffic
# and the admitted host-network UIDs from all other metadata access.
install -d -m 0755 /etc/thelve
cat > /etc/thelve/metadata-guard.nft <<'EOF'
table inet thelve_metadata_guard {
  chain output {
    type filter hook output priority -150; policy accept;
    ip daddr 169.254.169.254 udp dport 53 accept
    ip daddr 169.254.169.254 tcp dport 53 accept
    ip daddr 169.254.169.254 meta skuid { 999, 1000, 10001 } reject
  }
  chain forward {
    type filter hook forward priority -150; policy accept;
    ip daddr 169.254.169.254 udp dport 53 accept
    ip daddr 169.254.169.254 tcp dport 53 accept
    ip daddr 169.254.169.254 reject
  }
}
EOF
cat > /etc/systemd/system/thelve-metadata-guard.service <<'EOF'
[Unit]
Description=Block Thelve containers from the cloud metadata service
After=network-pre.target docker.service
Before=thelve.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/sbin/nft delete table inet thelve_metadata_guard
ExecStart=/usr/sbin/nft --file /etc/thelve/metadata-guard.nft

[Install]
WantedBy=multi-user.target
EOF
chmod 0644 /etc/systemd/system/thelve-metadata-guard.service
systemctl daemon-reload
systemctl enable --now thelve-metadata-guard.service

%{ if enable_ops_agent ~}
curl --fail --silent --show-error --location \
  --output /tmp/google-cloud-ops-agent.deb \
  '${ops_agent_package_url}'
printf '%s  %s\n' '${ops_agent_package_sha256}' /tmp/google-cloud-ops-agent.deb | sha256sum --check --strict
dpkg --install /tmp/google-cloud-ops-agent.deb
rm -f /tmp/google-cloud-ops-agent.deb
%{ endif ~}

systemctl enable --now docker
systemctl enable --now chrony
install -d -m 0750 /var/lib/thelve-bootstrap
printf 'schema=thelve.single-node-cloud-bootstrap/v2\nprovider=gcp\nsecret_values_recorded=false\n' > "$receipt"
chmod 0640 "$receipt"
