{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thelve.io/contracts/thelve-machine-image-catalog-v1.schema.json",
  "title": "Thelve machine image catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "spec"],
  "properties": {
    "schemaVersion": {"const": "thelve.machine-image-catalog/v1"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogVersion", "createdAt", "expiresAt", "sourceCommit"],
      "properties": {
        "catalogVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"},
        "createdAt": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packerVersion", "hostContract", "images"],
      "properties": {
        "packerVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "hostContract": {"const": "thelve.single-node-cloud-bootstrap/v1"},
        "images": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"$ref": "#/$defs/image"}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildManifestSha256", "packageInventorySha256", "sbomSha256", "vulnerabilityReportSha256", "hardeningReportSha256", "launchTestReceiptSha256"],
      "properties": {
        "buildManifestSha256": {"$ref": "#/$defs/digest"},
        "packageInventorySha256": {"$ref": "#/$defs/digest"},
        "sbomSha256": {"$ref": "#/$defs/digest"},
        "vulnerabilityReportSha256": {"$ref": "#/$defs/digest"},
        "hardeningReportSha256": {"$ref": "#/$defs/digest"},
        "launchTestReceiptSha256": {"$ref": "#/$defs/digest"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "region", "architecture", "imageId", "sourceImageId", "createdAt", "deprecatesAt", "status", "evidence"],
      "properties": {
        "provider": {"enum": ["gcp", "aws"]},
        "region": {"type": "string", "minLength": 2, "maxLength": 64},
        "architecture": {"const": "x86_64"},
        "imageId": {"type": "string", "minLength": 8, "maxLength": 512},
        "sourceImageId": {"type": "string", "minLength": 8, "maxLength": 512},
        "createdAt": {"type": "string", "format": "date-time"},
        "deprecatesAt": {"type": "string", "format": "date-time"},
        "status": {"enum": ["active", "deprecated", "revoked"]},
        "revocationReason": {"type": "string", "minLength": 8, "maxLength": 1024},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    }
  }
}
